{
  "title": "Settlement Recon operations",
  "uid": "settlement-recon",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [{"name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus"}]},
  "panels": [
    {"id": 1, "title": "Request rate", "type": "timeseries", "datasource": "${DS_PROMETHEUS}", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum by (status) (rate(settlement_recon_http_requests_total[5m]))", "refId": "A"}]},
    {"id": 2, "title": "HTTP p95 latency (seconds)", "type": "timeseries", "datasource": "${DS_PROMETHEUS}", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(settlement_recon_http_seconds_bucket[5m])))", "refId": "A"}]},
    {"id": 3, "title": "Ingestion attempts by outcome", "type": "timeseries", "datasource": "${DS_PROMETHEUS}", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}, "targets": [{"expr": "sum by (outcome) (increase(settlement_recon_batches_total[5m]))", "refId": "A"}]}
  ]
}
